# Server-only. Never use NEXT_PUBLIC_ for these values.
CALLMISSED_API_KEY=replace_with_your_key
REVIEWER_CODE=replace_with_a_long_random_access_code
SESSION_SECRET=replace_with_at_least_32_random_bytes
LIVE_ENABLED=false
# Maximum aggregate conservative reservations, in cents, across this ledger.
# Reduce for any prior spend; do not reset this when deploying.
APP_LIMIT_CENTS=1400
LEDGER_PATH=./data/usage.sqlite

# Expanded product: direct OpenAI website generation (not internship-compliant).
# Separate spending allowance; zero disables billable website generation.
OPENAI_API_KEY=
OPENAI_LIMIT_CENTS=0
